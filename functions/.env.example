# Copy to functions/.env (not committed). Loaded by Firebase CLI during deploy.
# Web app vars: see ../.env.example (includes VITE_ACCOUNT_APPROVAL_REQUIRED).
#
# Cloud Functions region. Must match VITE_FIREBASE_FUNCTIONS_REGION in the web app.
# FUNCTIONS_REGION=europe-west1
#
# Optional. Email of the service account used by callable functions (shares, lookup).
# Find it in Firebase Console → Project settings → Service accounts.
# If omitted, Firebase uses the project default runtime service account.
# FUNCTIONS_SERVICE_ACCOUNT=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
#
# Time zone for the scheduled reminders function.
# SCHEDULER_TIMEZONE=Europe/Lisbon

# --- Account approval + transactional email (optional) ---
# Requires Firebase Auth blocking functions (Identity Platform). See docs/configuration.md.
# When ACCOUNT_APPROVAL_REQUIRED=true, all variables below except INSTANCE_NAME and
# APPROVAL_HANDLER_BASE_URL are required.
#
# ACCOUNT_APPROVAL_REQUIRED=false
# ADMIN_EMAIL=admin@example.com
# APP_PUBLIC_URL=https://your-project.web.app
# INSTANCE_NAME=Queima Asfalto
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Queima Asfalto <noreply@your-domain.com>
# APPROVAL_TOKEN_SECRET=use-a-long-random-secret-at-least-16-chars
# Optional. Default approval link base: {APP_PUBLIC_URL}/api/account-approval (Firebase Hosting rewrite).
# APPROVAL_HANDLER_BASE_URL=https://your-project.web.app/api/account-approval

# --- Race discovery (optional, off by default) ---
# Comma separated source ids the weekly harvestRaceCatalog function may read.
# Empty or absent means the harvest returns immediately and fetches nothing:
# it reads third-party pages, so enabling it is the operator's decision.
# Read the source's robots.txt and terms before adding it. "all" enables every
# source this codebase knows. See docs/discovery-sources.md.
# DISCOVERY_SOURCES=acorrer.pt,davengo.com,scc-events.com,marathon.de,planet-marathon.de
