rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isApprovedUser(userId) {
      let userDoc = firestore.get(/databases/(default)/documents/users/$(userId));
      return userDoc != null
        && userDoc.data != null
        && (!('accountStatus' in userDoc.data) || userDoc.data.accountStatus == 'approved');
    }

    match /users/{userId}/events/{eventId}/media/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid == userId
        && isApprovedUser(userId);
      allow write: if request.auth != null
        && request.auth.uid == userId
        && isApprovedUser(userId)
        && (
          (request.resource.contentType.matches('image/.*')
            && request.resource.size <= 5 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*')
            && request.resource.size <= 100 * 1024 * 1024)
        );
      allow delete: if request.auth != null
        && request.auth.uid == userId
        && isApprovedUser(userId);
    }
  }
}
